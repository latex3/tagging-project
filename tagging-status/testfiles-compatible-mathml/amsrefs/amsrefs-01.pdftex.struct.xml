        id="ID.022"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="1" ?>... fossil record for Devonian and Carboniferous vascular land plants (Niklaset al., 1980; 1983; Gensel and Andrews, 1984).
     </text-block>
    </semantic-para>
