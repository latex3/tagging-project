      <math display="block" xmlns="http://www.w3.org/1998/Math/MathML"> <msub> <mo lspace="0" rspace="0.167em">∫</mo> <mi mathvariant="normal">M</mi> </msub> <mi mathvariant="normal">K</mi> <mspace width="2.953pt"/> <mi mathvariant="normal">d</mi> <mi mathvariant="normal">A</mi> <mo lspace="0.222em" rspace="0">+</mo> <msub> <mo lspace="0.222em" rspace="0.167em">∫</mo> <mrow> <mo lspace="0" rspace="0">∂</mo> <mi mathvariant="normal">M</mi> </mrow> </msub> <msub> <mi mathvariant="normal">k</mi> <mi mathvariant="normal">g</mi> </msub> <mspace width="2.953pt"/> <mi mathvariant="normal">d</mi> <mi mathvariant="normal">s</mi> <mo lspace="0.278em" rspace="0.278em">=</mo> <mn>2</mn> <mi mathvariant="normal">π</mi> <mi mathvariant="normal">χ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">M</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> </math>
