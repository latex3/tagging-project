      <AssociatedFile name="mathml-8.xml" xmlns="">
      <math display="block" xmlns="http://www.w3.org/1998/Math/MathML"> <mtable class="align" columnalign="left right left" columnspacing="0 0" displaystyle="true" intent=":system-of-equations"> <mtr> <mtd intent=":no-equation-label"></mtd> <mtd intent=":pause-medium"> <mfrac> <mi mathvariant="normal">∂</mi> <mrow> <mo lspace="0" rspace="0">∂</mo> <mi mathvariant="normal">t</mi> </mrow> </mfrac> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">ρ</mi> <mi mathvariant="normal">u</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> <mo lspace="0.222em" rspace="0.222em">+</mo> <mi mathvariant="normal">∇</mi> <mo lspace="0.222em" rspace="0">•</mo> <mo lspace="0.222em" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">ρ</mi> <mi mathvariant="normal">u</mi> <mo lspace="0.222em" rspace="0.222em">⊗</mo> <mi mathvariant="normal">u</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> <mo lspace="0.278em" rspace="0.278em">=</mo> </mtd> <mtd> <mi mathvariant="normal">−</mi> <mi mathvariant="normal">∇</mi> <mover> <mi mathvariant="normal">p</mi> <mo>ˉ</mo> </mover> <mo lspace="0.222em" rspace="0.222em">+</mo> <mi mathvariant="normal">μ</mi> <msup> <mi mathvariant="normal">∇</mi> <mn>2</mn> </msup> <mi mathvariant="normal">u</mi> </mtd> </mtr> <mtr> <mtd intent=":no-equation-label"></mtd> <mtd intent=":pause-medium"/> <mtd> <mo lspace="0.222em" rspace="0.222em">+</mo> <mfrac> <mn>1</mn> <mn>3</mn> </mfrac> <mi mathvariant="normal">μ</mi> <mi mathvariant="normal">∇</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">∇</mi> <mo lspace="0.222em" rspace="0.222em">•</mo> <mi mathvariant="normal">u</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> <mo lspace="0.222em" rspace="0.222em">+</mo> <mi mathvariant="normal">ρ</mi> <mi mathvariant="normal">g</mi> </mtd> </mtr> </mtable> </math>
      </AssociatedFile>
      <AssociatedFile name="tag-AFfile8.tex" xmlns="">
      \begin {align*}\frac {\partial }{\partial t}(\rho \mathbf {u})+\nabla \bullet (\rho \mathbf {u}\otimes \mathbf {u})={} &amp;{-}\nabla \bar p+\mu \nabla ^2\mathbf {u}\\ &amp;+\frac 13\mu \nabla (\nabla \bullet u)+ \rho \mathbf {g}\end {align*}
      </AssociatedFile>
     <?MarkedContent page="1" ?>∂∂t(ρu)+∆•(ρu⊗u)=−∆ˉp+μ∆2u
