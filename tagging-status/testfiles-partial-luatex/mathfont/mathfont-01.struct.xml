      <math display="block" xmlns="http://www.w3.org/1998/Math/MathML"> <mtable class="align" columnalign="left right left" columnspacing="0 0" displaystyle="true" intent=":system-of-equations"> <mtr> <mtd intent=":no-equation-label"></mtd> <mtd intent=":pause-medium"> <mi mathvariant="normal">ζ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> </mtd> <mtd> <mo lspace="0.278em" rspace="0">=</mo> <munderover> <mo lspace="0.278em" movablelimits="true" rspace="0.167em">∑</mo> <mrow> <mi mathvariant="normal">i</mi> <mo lspace="0" rspace="0">=</mo> <mn>1</mn> </mrow> <mi mathvariant="normal">∞</mi> </munderover> <mfrac> <mn>1</mn> <msup> <mi mathvariant="normal">z</mi> <mi mathvariant="normal">i</mi> </msup> </mfrac> <mo lspace="0.278em" rspace="0.278em">=</mo> <mfrac> <mn>1</mn> <mrow> <mi mathvariant="normal">Γ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> </mrow> </mfrac> <msubsup> <mo lspace="0.167em" rspace="0.167em">∫</mo> <mn>0</mn> <mi mathvariant="normal">∞</mi> </msubsup> <mfrac> <msup> <mi mathvariant="normal">x</mi> <mrow> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0">−</mo> <mn>1</mn> </mrow> </msup> <mrow> <msup> <mi mathvariant="normal">e</mi> <mi mathvariant="normal">x</mi> </msup> <mo lspace="0.222em" rspace="0.222em">−</mo> <mn>1</mn> </mrow> </mfrac> <mspace width="2.953pt"/> <mi mathvariant="normal">d</mi> <mi mathvariant="normal">x</mi> </mtd> </mtr> <mtr> <mtd intent=":no-equation-label"></mtd> <mtd intent=":pause-medium"/> <mtd> <mo lspace="0.278em" rspace="0.278em">=</mo> <msup> <mn>2</mn> <mi mathvariant="normal">z</mi> </msup> <msup> <mi mathvariant="normal">π</mi> <mrow> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0">−</mo> <mn>1</mn> </mrow> </msup> <mspace width="0.167em"/> <mi mathvariant="normal"> sin </mi> <mspace width="0.167em"/> <mrow> <mo fence="true" lspace="0" rspace="0" symmetric="true">(</mo> <mfrac> <mrow> <mi mathvariant="normal">π</mi> <mi mathvariant="normal">z</mi> </mrow> <mn>2</mn> </mfrac> <mo fence="true" lspace="0" rspace="0" symmetric="true">)</mo> </mrow> <mspace width="0.167em"/> <mspace width="0.167em"/> <mi mathvariant="normal">Γ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mn>1</mn> <mo lspace="0.222em" rspace="0.222em">−</mo> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> <mspace width="0.167em"/> <mi mathvariant="normal">ζ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mn>1</mn> <mo lspace="0.222em" rspace="0.222em">−</mo> <mi mathvariant="normal">z</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> </mtd> </mtr> </mtable> </math>
      </AssociatedFile>
      <AssociatedFile name="tag-AFfile13.tex" xmlns="">
      \begin {align*}\zeta (z)&amp;=\sum _{i=1}^\infty \frac 1{z^i} =\frac 1{\Gamma (z)}\int _0^\infty \frac {x^{z-1}}{e^x-1}\ dx\\ &amp;=2^z\pi ^{z-1}\sin \left (\frac {\pi z}2\right )\,\Gamma (1-z)\,\zeta (1-z)\end {align*}
      </AssociatedFile>
     <?MarkedContent page="1" ?>ζ(z)=∞∑i=11zi=1Γ(z)∫∞0xz−1ex−1dx
     <?MarkedContent page="1" ?>=2zπz−1sin(πz2)Γ(1−z)ζ(1−z)
    </Formula>
