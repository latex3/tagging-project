      >
      <AssociatedFile name="mathml-3.xml" xmlns="">
      <math display="block" xmlns="http://www.w3.org/1998/Math/MathML"> <msub> <mi mathvariant="normal">R</mi> <mrow> <mi mathvariant="normal">μ</mi> <mi mathvariant="normal">ν</mi> </mrow> </msub> <mo lspace="0.222em" rspace="0.222em">−</mo> <mfrac> <mn>1</mn> <mn>2</mn> </mfrac> <mi mathvariant="normal">R</mi> <msub> <mi mathvariant="normal">g</mi> <mrow> <mi mathvariant="normal">μ</mi> <mi mathvariant="normal">ν</mi> </mrow> </msub> <mo lspace="0.222em" rspace="0.222em">+</mo> <mi mathvariant="normal">Λ</mi> <msub> <mi mathvariant="normal">g</mi> <mrow> <mi mathvariant="normal">μ</mi> <mi mathvariant="normal">ν</mi> </mrow> </msub> <mo lspace="0.278em" rspace="0.278em">=</mo> <mfrac> <mrow> <mn>8</mn> <mi mathvariant="normal">π</mi> <mi mathvariant="normal">G</mi> </mrow> <msup> <mi mathvariant="normal">c</mi> <mn>4</mn> </msup> </mfrac> <msub> <mi mathvariant="normal">T</mi> <mrow> <mi mathvariant="normal">μ</mi> <mi mathvariant="normal">ν</mi> </mrow> </msub> </math>
      </AssociatedFile>
      <AssociatedFile name="tag-AFfile3.tex" xmlns="">
      \begin {equation*}R_{\mu \nu }-\frac 12Rg_{\mu \nu }+\Lambda g_{\mu \nu }=\frac {8\pi G}{c^4}T_{\mu \nu }\end {equation*}
      </AssociatedFile>
     <?MarkedContent page="1" ?>Rμν−12Rgμν+Λgμν=8πGc4Tμν
    </Formula>
