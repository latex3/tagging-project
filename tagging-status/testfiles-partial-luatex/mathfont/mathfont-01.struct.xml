      <math display="block" xmlns="http://www.w3.org/1998/Math/MathML"> <mi mathvariant="normal">φ</mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">X</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> <mo lspace="0.278em" rspace="0.278em"> <math xmlns="http://www.w3.org/1998/Math/MathML"> <mstyle displaystyle="true" scriptlevel="0"> <mo lspace="0" rspace="0" stretchy="false">~</mo> </mstyle> </math> <math xmlns="http://www.w3.org/1998/Math/MathML"> <mstyle displaystyle="true" scriptlevel="0"> <mo lspace="0" rspace="0">=</mo> </mstyle> </math> </mo> <mi mathvariant="normal">X</mi> <mo lspace="0" rspace="0.167em">/</mo> <mi mathvariant="normal"> ker </mi> <mo lspace="0" rspace="0" stretchy="false">(</mo> <mi mathvariant="normal">φ</mi> <mo lspace="0" rspace="0" stretchy="false">)</mo> </math>
