riant="normal">q</mi> <mn>2</mn> </mfrac> <mo lspace="0.222em" rspace="0.222em">−</mo> <msqrt> <mrow> <mspace width="0.056em"/> <mfrac> <msup> <mi mathvariant="normal">q</mi> <mn>2</mn> </msup> <mn>4</mn> </mfrac> <mo lspace="0.222em" rspace="0.222em">+</mo> <mfrac> <msup> <mi mathvariant="normal">p</mi> <mn>3</mn> </msup> <mn> 27 </mn> </mfrac> </mrow> </msqrt> </mrow> </msqrt> </mstyle> </math> </mtext> </mrow> </mtd> </mtr> </mtable> </math>
