% adjustments for latex-nightly
TEXINPUTS.latex-nightly       = $TEXMFDOTDIR;$TEXMF/tex/{latex-nightly,latex-dev,latex,generic,}//
TEXINPUTS.pdflatex-nightly    = $TEXMFDOTDIR;$TEXMF/tex/{latex-nightly,latex-dev,latex,generic,}//
TEXINPUTS.lualatex-nightly    = $TEXMFDOTDIR;$TEXMF/tex/{latex-nightly,latex-dev,lualatex,latex,luatex,generic,}//
TEXINPUTS.dvilualatex-nightly = $TEXMFDOTDIR;$TEXMF/tex/{latex-nightly,latex-dev,lualatex,latex,luatex,generic,}//
LUAINPUTS.lualatex-nightly    = $TEXMFDOTDIR;$TEXMF/scripts/{$progname,$engine,}/{lua,}//;$TEXMF/tex/{latex-nightly,latex-dev,lualatex,latex,luatex,generic,}//
LUAINPUTS.dvilualatex-nightly = $TEXMFDOTDIR;$TEXMF/scripts/{$progname,$engine,}/{lua,}//;$TEXMF/tex/{latex-nightly,latex-dev,lualatex,latex,luatex,generic,}//
